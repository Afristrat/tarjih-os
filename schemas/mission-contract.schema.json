{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarjih-os.com/schemas/mission-contract.schema.json",
  "title": "Tarjih Mission Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "version",
    "title",
    "domain",
    "risk_level",
    "objective",
    "required_inputs",
    "deterministic_tasks",
    "ai_tasks",
    "hypothesis_parameters",
    "human_reviews",
    "output_artifacts",
    "external_services",
    "execution_limits"
  ],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^M(0[1-9]|[12][0-9]|30)$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["standard", "high", "critical"]},
    "objective": {"type": "string", "minLength": 1},
    "required_inputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "deterministic_tasks": {"$ref": "#/$defs/nonEmptyStrings"},
    "ai_tasks": {"$ref": "#/$defs/nonEmptyStrings"},
    "hypothesis_parameters": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
      "uniqueItems": true
    },
    "human_reviews": {"$ref": "#/$defs/nonEmptyStrings"},
    "output_artifacts": {"$ref": "#/$defs/nonEmptyStrings"},
    "external_services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["saqr", "bassira"],
      "properties": {
        "saqr": {"enum": ["disabled", "optional", "recommended"]},
        "bassira": {"enum": ["disabled", "optional", "recommended"]}
      }
    },
    "execution_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_model_calls", "max_external_calls", "timeout_seconds"],
      "properties": {
        "max_model_calls": {"type": "integer", "minimum": 1, "maximum": 6},
        "max_external_calls": {"type": "integer", "minimum": 0, "maximum": 4},
        "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 300}
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
