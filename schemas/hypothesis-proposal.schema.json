{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarjih-os.com/schemas/hypothesis-proposal.schema.json",
  "title": "Tarjih Hypothesis Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis_id",
    "label",
    "parameter_key",
    "proposed_value",
    "unit",
    "period",
    "scope",
    "rationale",
    "evidence_refs",
    "counter_evidence_refs",
    "uncertainties",
    "verification_method",
    "sensitivity",
    "status"
  ],
  "properties": {
    "hypothesis_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1, "maxLength": 200},
    "parameter_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "proposed_value": {
      "type": ["number", "string", "boolean", "null"]
    },
    "unit": {"type": ["string", "null"]},
    "period": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_ids"],
      "properties": {
        "dimension_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "counter_evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "uncertainties": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "verification_method": {"type": "string", "minLength": 1},
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "base", "high"],
      "properties": {
        "low": {"type": ["number", "string", "boolean", "null"]},
        "base": {"type": ["number", "string", "boolean", "null"]},
        "high": {"type": ["number", "string", "boolean", "null"]}
      }
    },
    "status": {"const": "proposed"}
  }
}
